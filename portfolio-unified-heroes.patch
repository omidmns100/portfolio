 }
+
+/* Unified inner-page hero: a normal image in document flow, never transformed. */
+.portfolio-archive .inner-page-hero {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 14px;
+  align-items: start;
+  min-height: 0;
+  margin-top: 105px;
+  margin-bottom: 0;
+}
+.portfolio-archive .inner-page-hero-copy { min-width: 0; padding: 0; text-align: right; }
+.portfolio-archive .inner-page-hero-copy h1 { font-size: clamp(27px, 3.4vw, 43px); color: #263e4a; line-height: 1.5; }
+.portfolio-archive .inner-page-hero-copy p { font-size: 14px; line-height: 2; max-width: 550px; margin-top: 16px; }
+.portfolio-archive .inner-page-hero-banner { min-width: 0; width: 100%; }
+.portfolio-archive .inner-page-hero-banner img {
+  display: block;
+  width: 100%;
+  height: auto;
+  aspect-ratio: 2456 / 1592;
+  object-fit: contain;
+  transform: none;
+}
+/* Equal distance to the following section, regardless of which page is shown. */
+.portfolio-archive .inner-page-hero + section { margin-top: 40px; }
+@media (max-width: 700px) {
+  .portfolio-archive .inner-page-hero {
+    grid-template-columns: 1fr;
+    gap: 20px;
+    margin-top: 32px;
+  }
+  .portfolio-archive .inner-page-hero-copy p { font-size: 13px; }
+  .portfolio-archive .inner-page-hero + section { margin-top: 32px; }
+}
