+
+/* Uploaded banners: preserve their artwork and original proportions. */
+.asset { position: relative; }
+.hero { position: relative; isolation: isolate; display: flex; flex-direction: column; min-height: 0; aspect-ratio: 3000 / 1466; border-radius: 0 0 38px 38px; }
+.hero-background { position: absolute; inset: 0; z-index: -1; border-radius: inherit; }
+.hero-body { flex: 1; min-height: 0; }
+.hero-copy { padding-block: 34px; }
+.project-card .asset { aspect-ratio: 2567 / 1179; }
+.project-card:last-child:nth-child(odd) { grid-column: 1 / -1; width: calc((100% - 12px) / 2); justify-self: center; }
+.service-card .asset { aspect-ratio: 1250 / 2629; }
+.service-cta { top: 43%; min-height: 32px; }
+.brand { border-color: #135ce8; }
+.brand img { padding: 10px 14px; }
+.process-grid { align-items: center; }
+.process-art { aspect-ratio: 1; min-height: 0; }
+.gallery-grid { grid-auto-rows: clamp(90px, 24vw, 326px); }
+.gallery-item { height: auto; background-color: #f2f3f5; }
+.contact { grid-template-columns: 1.15fr 1fr; align-items: center; }
+.contact-art { aspect-ratio: 1; min-height: 0; }
+.form-panel { width: 100%; }
+@media (max-width: 1000px) and (min-width: 701px) {
+  .hero h1 { font-size: clamp(23px, 3vw, 30px); }
+  .hero-copy { padding-block: 22px; }
+  .hero p { margin-top: 12px; font-size: 12px; }
+  .hero-actions { margin-top: 18px; }
+}
+@media (max-width: 700px) {
+  .hero { aspect-ratio: auto; min-height: 0; background-color: #3d7cf0; }
+  /* Keep the full desktop artwork visible below the copy until a mobile banner exists. */
+  .hero-background { top: auto; aspect-ratio: 3000 / 1466; }
+  .hero-body { min-height: 0; }
+  .hero-copy { padding: 32px 0 calc(49vw + 20px); }
+  .service-cta { min-height: 26px; padding: 3px 14px; font-size: 11px; }
+  .brand img { padding: 6px; }
+  .process-art { width: min(100%, 420px); justify-self: center; }
+  .contact { grid-template-columns: 1fr; }
+  .contact-art { width: min(100%, 420px); justify-self: center; }
+  .project-card:last-child:nth-child(odd) { width: calc((100% - 9px) / 2); }
+}
+/* Keep the spam-trap field hidden without creating RTL horizontal overflow. */
+.contact-form { position: relative; }
+.honeypot { left: 0; top: 0; clip-path: inset(50%); pointer-events: none; }
